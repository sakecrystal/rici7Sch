{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": ["build", "${workspaceFolder}/rici7Sch.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": ["watch", "run", "--project", "${workspaceFolder}/rici7Sch/rici7Sch.csproj"],
            "options": { "cwd": "${workspaceFolder}/rici7Sch" },
            "problemMatcher": "$msCompile",
            "isBackground": true
        },
        {
            "label": "convert-help",
            "detail": "HelpSource/ の RoboHelp 資産から Pages/Topics と Data/*.json を再生成",
            "command": "python3",
            "type": "process",
            "args": ["${workspaceFolder}/rici7Sch/tools/convert_help.py"],
            "problemMatcher": []
        },
        {
            "label": "Claude: セッション一覧",
            "detail": "動いている Claude Code のセッションを表示",
            "type": "process",
            "command": "${workspaceFolder}/scripts/claude-sessions.sh",
            "args": ["list"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Claude: 古いセッションを停止",
            "detail": "最新以外の Claude Code のセッションを停止 (確認あり)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/claude-sessions.sh",
            "args": ["stop-old"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true }
        },
        {
            "label": "アプリ: 残っている rici7Sch を停止",
            "detail": "ポート 5276 の使用中エラーが出たときに、残っているアプリを停止 (確認あり)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/claude-sessions.sh",
            "args": ["stop-app"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true }
        }
    ]
}
