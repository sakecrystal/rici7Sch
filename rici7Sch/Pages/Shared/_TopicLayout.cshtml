@using rici7Sch.Pages.Topics
@using rici7Sch.Services
@{
    Layout = "_Layout";
    // 各トピックの PageModel (生成された .cshtml.cs) の情報を使う
    var topic = (TopicPageModel)ViewContext.ViewData.Model!;
    var nav = topic.Navigation;
}
@* 移植したヘルプトピック共通の枠: パンくず・タイトル・このページの内容・関連トピック・前後トピック *@
<article class="topic" data-topic-id="@topic.TopicId">
    <nav aria-label="パンくずリスト">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">ホーム</a></li>
            @foreach (var b in nav.Breadcrumb)
            {
                if (b.Url is not null)
                {
                    <li class="breadcrumb-item"><a href="@Url.Content("~" + b.Url)">@b.Title</a></li>
                }
                else
                {
                    <li class="breadcrumb-item">@b.Title</li>
                }
            }
        </ol>
    </nav>

    <header class="topic-header">
        <div class="topic-heading">
            <h1 class="topic-title">@topic.Title</h1>
            @if (!string.IsNullOrEmpty(topic.OriginalTitle) && topic.OriginalTitle != topic.Title)
            {
                <p class="topic-original">原文: <span lang="en">@topic.OriginalTitle</span></p>
            }
        </div>
        <div class="topic-tools" role="toolbar" aria-label="トピックの操作">
            @if (topic.DropdownCount > 0)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" id="expandAll" hidden>すべて展開</button>
            }
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="print">印刷</button>
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Content("~/Classic?topic=" + Uri.EscapeDataString(topic.TopicId))"
               title="元の英語のページ (@topic.SourceFile) を Classic 表示で開く">原文 (英語)</a>
        </div>
    </header>

    @if (topic.ShowSections)
    {
        <details class="topic-sections" open="@(topic.Sections.Count <= 12)">
            <summary>このページの内容 <span class="ui-meta">@topic.Sections.Count 項目</span></summary>
            <ol class="topic-sections-list">
                @foreach (var s in topic.Sections)
                {
                    <li class="level-@s.Level"><a href="#@s.Id">@s.Title</a></li>
                }
            </ol>
        </details>
    }

    <div class="help-content">
        @RenderBody()
    </div>

    @if (topic.RelatedTopics.Count > 0 || topic.ReferencedBy.Count > 0 || topic.Keywords.Count > 0)
    {
        <aside class="topic-related" aria-label="関連情報">
            @if (topic.RelatedTopics.Count > 0)
            {
                <section>
                    <h2 class="topic-related-title">関連トピック</h2>
                    <ul>
                        @foreach (var t in topic.RelatedTopics)
                        {
                            var popup = topic.PopupTopics.Contains(t.Id, StringComparer.OrdinalIgnoreCase);
                            <li>
                                @if (popup)
                                {
                                    <a href="@Url.Content("~" + t.Url)" data-help-popup="true" class="help-popup-link">@t.Title</a>
                                    <span class="ui-meta">（ポップアップ）</span>
                                }
                                else
                                {
                                    <a href="@Url.Content("~" + t.Url)">@t.Title</a>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (topic.ReferencedBy.Count > 0)
            {
                <section>
                    <h2 class="topic-related-title">このページを参照しているトピック</h2>
                    <ul>
                        @foreach (var t in topic.ReferencedBy)
                        {
                            <li><a href="@Url.Content("~" + t.Url)">@t.Title</a></li>
                        }
                    </ul>
                </section>
            }
            @if (topic.Keywords.Count > 0)
            {
                <section>
                    <h2 class="topic-related-title">索引キーワード</h2>
                    <p class="topic-keywords">
                        @foreach (var k in topic.Keywords)
                        {
                            <a class="keyword-chip" asp-page="/Keywords" asp-route-k="@k.Keyword">@k.Keyword</a>
                        }
                    </p>
                </section>
            }
        </aside>
    }

    <nav class="topic-pager" aria-label="前後のトピック">
        @if (nav.Previous is not null)
        {
            <a class="pager-link prev" href="@Url.Content("~" + nav.Previous.Url)" rel="prev">
                <span class="pager-label">&laquo; 前へ</span>
                <span class="pager-title">@nav.Previous.Title</span>
            </a>
        }
        else
        {
            <span></span>
        }
        @if (nav.Next is not null)
        {
            <a class="pager-link next" href="@Url.Content("~" + nav.Next.Url)" rel="next">
                <span class="pager-label">次へ &raquo;</span>
                <span class="pager-title">@nav.Next.Title</span>
            </a>
        }
    </nav>
</article>

@section LegacyScripts {
    @if (topic.DropdownCount > 0)
    {
        @* 元のヘルプの DHTML スクリプト。ドロップダウンの開閉 (kadovTextPopup) に使う *@
        <script src="~/js/ehlpdhtm.js" asp-append-version="true"></script>
    }
}
