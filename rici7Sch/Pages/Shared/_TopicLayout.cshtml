@using rici7Sch.Services
@{
    Layout = "_Layout";
    var nav = (TopicNavigation)ViewData["TopicNavigation"]!;
}
@* 移植したヘルプトピック共通の枠: パンくず・タイトル・ツールバー・前後トピック *@
<article class="topic" data-topic-id="@nav.Topic.Id">
    <nav aria-label="パンくずリスト">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">ホーム</a></li>
            @foreach (var b in nav.Breadcrumb)
            {
                if (b.Url is not null)
                {
                    <li class="breadcrumb-item"><a href="@Url.Content("~" + b.Url)">@b.Title</a></li>
                }
                else
                {
                    <li class="breadcrumb-item">@b.Title</li>
                }
            }
        </ol>
    </nav>

    <header class="topic-header">
        <div class="topic-heading">
            <h1 class="topic-title">@nav.Topic.Title</h1>
            @if (!string.IsNullOrEmpty(nav.Topic.TitleEn) && nav.Topic.TitleEn != nav.Topic.Title)
            {
                <p class="topic-original">原文: <span lang="en">@nav.Topic.TitleEn</span></p>
            }
        </div>
        <div class="topic-tools" role="toolbar" aria-label="トピックの操作">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="expandAll" hidden>すべて展開</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="print">印刷</button>
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Content("~/Classic?topic=" + Uri.EscapeDataString(nav.Topic.Id))" title="元の英語のページを Classic 表示で開く">原文 (英語)</a>
        </div>
    </header>

    <div class="help-content">
        @RenderBody()
    </div>

    <nav class="topic-pager" aria-label="前後のトピック">
        @if (nav.Previous is not null)
        {
            <a class="pager-link prev" href="@Url.Content("~" + nav.Previous.Url)" rel="prev">
                <span class="pager-label">&laquo; 前へ</span>
                <span class="pager-title">@nav.Previous.Title</span>
            </a>
        }
        else
        {
            <span></span>
        }
        @if (nav.Next is not null)
        {
            <a class="pager-link next" href="@Url.Content("~" + nav.Next.Url)" rel="next">
                <span class="pager-label">次へ &raquo;</span>
                <span class="pager-title">@nav.Next.Title</span>
            </a>
        }
    </nav>
</article>
