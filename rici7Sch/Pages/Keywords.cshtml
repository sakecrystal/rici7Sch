@page
@model KeywordsModel
@{
    ViewData["Title"] = "索引";
}
<article class="topic">
    <nav aria-label="パンくずリスト">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">ホーム</a></li>
            <li class="breadcrumb-item active" aria-current="page">索引</li>
        </ol>
    </nav>
    <header class="topic-header">
        <h1 class="topic-title">索引</h1>
    </header>

    <form method="get" class="filter-bar" role="search" data-keyword-filter>
        <label for="keywordFilter" class="form-label">検索するキーワードを入力してください:</label>
        <div class="d-flex gap-2">
            <input id="keywordFilter" name="k" class="form-control" type="search" value="@Model.Filter" autocomplete="off" />
            <noscript><button class="btn btn-primary" type="submit">絞り込む</button></noscript>
        </div>
        <p class="filter-count" aria-live="polite"><span data-count>@Model.Total</span> 件のキーワード</p>
    </form>

    <nav class="alpha-nav" aria-label="頭文字へ移動">
        @foreach (var g in Model.Groups)
        {
            <a href="#kw-@KeywordsModel.Slug(g.Key)" data-alpha="@g.Key">@g.Key</a>
        }
    </nav>

    @if (Model.Total == 0)
    {
        <p class="empty-state">「@Model.Filter」に一致するキーワードはありません。</p>
    }

    <div class="keyword-index">
        @foreach (var g in Model.Groups)
        {
            <section class="keyword-group" id="kw-@KeywordsModel.Slug(g.Key)" data-group="@g.Key">
                <h2 class="keyword-letter">@g.Key</h2>
                <dl class="keyword-list">
                    @foreach (var e in g)
                    {
                        <div class="keyword-entry" data-keyword="@e.Keyword.ToLowerInvariant()">
                            @if (e.Topics.Count == 1)
                            {
                                <dt><a href="@Url.Content("~" + e.Topics[0].Url)">@e.Keyword</a></dt>
                                @if (!string.Equals(e.Topics[0].Title, e.Keyword, StringComparison.OrdinalIgnoreCase))
                                {
                                    <dd class="keyword-single">@e.Topics[0].Title</dd>
                                }
                            }
                            else
                            {
                                @* 複数トピックに該当するキーワードは「トピックの選択」を一覧で表示 *@
                                <dt>@e.Keyword <span class="badge text-bg-light">@e.Topics.Count</span></dt>
                                <dd>
                                    <ul class="keyword-topics">
                                        @foreach (var t in e.Topics)
                                        {
                                            <li><a href="@Url.Content("~" + t.Url)">@t.Title</a></li>
                                        }
                                    </ul>
                                </dd>
                            }
                        </div>
                    }
                </dl>
            </section>
        }
    </div>
    <p class="empty-state" data-empty hidden>一致するキーワードはありません。</p>
</article>
