@page
@model ErrorModel
@{
    ViewData["Title"] = Model.IsNotFound ? "ページが見つかりません" : "エラー";
}
<section class="status-page">
    <p class="status-code">@Model.Code</p>
    @if (Model.IsNotFound)
    {
        <h1 class="status-title">ページが見つかりません</h1>
        <p class="status-text">
            お探しのページ
            @if (!string.IsNullOrEmpty(Model.OriginalPath))
            {
                <code>@Model.OriginalPath</code>
            }
            は存在しません。移動したか、リンクが間違っている可能性があります。
        </p>
    }
    else
    {
        <h1 class="status-title">エラーが発生しました</h1>
        <p class="status-text">要求の処理中にエラーが発生しました。もう一度お試しください。</p>
    }

    <div class="status-actions">
        <a class="btn btn-primary" asp-page="/Index">ホームに戻る</a>
        <a class="btn btn-outline-secondary" asp-page="/Search">ヘルプを検索</a>
        <a class="btn btn-outline-secondary" asp-page="/Keywords">索引を見る</a>
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="status-meta">要求 ID: <code>@Model.RequestId</code></p>
    }
</section>
