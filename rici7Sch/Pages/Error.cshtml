@page
@model ErrorModel
@{
    ViewData["Title"] = Model.IsNotFound ? "Page not found" : "Error";
}
<section class="status-page">
    <p class="status-code">@Model.Code</p>
    @if (Model.IsNotFound)
    {
        <h1 class="status-title">Topic not found</h1>
        <p class="status-text">
            The page
            @if (!string.IsNullOrEmpty(Model.OriginalPath))
            {
                <code>@Model.OriginalPath</code>
            }
            does not exist. It may have been moved, or the link may be incorrect.
        </p>
    }
    else
    {
        <h1 class="status-title">Something went wrong</h1>
        <p class="status-text">An error occurred while processing your request. Please try again.</p>
    }

    <div class="status-actions">
        <a class="btn btn-primary" asp-page="/Index">Back to Home</a>
        <a class="btn btn-outline-secondary" asp-page="/Search">Search help</a>
        <a class="btn btn-outline-secondary" asp-page="/Keywords">Browse index</a>
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="status-meta">Request ID: <code>@Model.RequestId</code></p>
    }
</section>
