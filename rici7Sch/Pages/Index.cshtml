@page
@model IndexModel
@using rici7Sch.Services
@{
    ViewData["Title"] = "ホーム";
}
<div class="home">
    <section class="hero">
        <p class="hero-eyebrow">RPCS プリンタードライバー</p>
        <h1 class="hero-title">プリンタードライバー ヘルプ</h1>
        <p class="hero-lead">
            印刷設定のタブ・メニュー・ダイアログボックスの説明と、
            よく使う印刷機能の操作手順をまとめています（本文は英語）。
        </p>
        <form class="hero-search" role="search" method="get" asp-page="/Search">
            <label class="visually-hidden" for="heroSearch">ヘルプを検索</label>
            <input id="heroSearch" class="form-control" type="search" name="q" placeholder="例: booklet, staple, toner saving" />
            <button class="btn btn-primary" type="submit">検索</button>
        </form>
        <ul class="hero-stats">
            <li>トピック <strong>@Model.TopicCount</strong> 件</li>
            <li>索引キーワード <strong>@Model.KeywordCount</strong> 件</li>
            <li>セクション <strong>@Model.Sections.Count</strong> 件</li>
        </ul>
    </section>

    <section aria-labelledby="pagesHeading">
        <h2 id="pagesHeading" class="section-heading">ページ一覧</h2>
        <div class="page-grid">
            @foreach (var p in Model.Pages)
            {
                <a class="page-card" href="@Url.Content("~" + p.Url)">
                    <strong>@p.Title</strong>
                    <span>@p.Description</span>
                    <code>@p.Url</code>
                </a>
            }
        </div>
    </section>

    <section aria-labelledby="sectionsHeading">
        <h2 id="sectionsHeading" class="section-heading">目次</h2>
        <div class="section-grid">
            @foreach (var s in Model.Sections)
            {
                var url = IndexModel.FirstUrl(s);
                <div class="section-card">
                    <h3 class="section-card-title">
                        @if (url is not null)
                        {
                            <a href="@Url.Content("~" + url)">@s.Title</a>
                        }
                        else
                        {
                            @s.Title
                        }
                    </h3>
                    @if (s.Children.Count > 0)
                    {
                        <ul class="section-card-list">
                            @foreach (var (c, depth) in HelpCatalog.Flatten(s.Children))
                            {
                                <li class="@(depth > 0 ? "sub" : "")">
                                    @if (c.Url is not null)
                                    {
                                        <a href="@Url.Content("~" + c.Url)">@c.Title</a>
                                    }
                                    else
                                    {
                                        <strong>@c.Title</strong>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
            @if (Model.OtherTopics.Count > 0)
            {
                <div class="section-card">
                    <h3 class="section-card-title">その他のトピック</h3>
                    <ul class="section-card-list">
                        @foreach (var t in Model.OtherTopics)
                        {
                            <li><a href="@Url.Content("~" + t.Url)">@t.Title</a></li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>

    <section aria-labelledby="allHeading">
        <h2 id="allHeading" class="section-heading">全トピック (A–Z)</h2>
        <details class="all-topics-box">
            <summary>全 @Model.TopicCount 件のトピックを表示</summary>
            <ul class="all-topics">
                @foreach (var g in Model.AllTopics)
                {
                    <li class="letter">@g.Key</li>
                    @foreach (var t in g)
                    {
                        <li><a href="@Url.Content("~" + t.Url)">@t.Title</a></li>
                    }
                }
            </ul>
        </details>
    </section>
</div>
