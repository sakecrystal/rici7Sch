@page
@model SearchModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? "検索" : $"検索: {Model.Query}";
}
<article class="topic">
    <nav aria-label="パンくずリスト">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">ホーム</a></li>
            <li class="breadcrumb-item active" aria-current="page">検索</li>
        </ol>
    </nav>
    <header class="topic-header">
        <h1 class="topic-title">検索</h1>
    </header>

    <form method="get" class="filter-bar" role="search">
        <label for="searchInput" class="form-label">検索する語句を入力してください:</label>
        <div class="d-flex gap-2">
            <input id="searchInput" name="q" class="form-control" type="search" value="@Model.Query" autofocus />
            <button class="btn btn-primary" type="submit">検索</button>
        </div>
        <p class="filter-hint">すべての語句を含むトピックを表示します。本文は英語なので英語で入力してください。語句をそのまま探すときは <code>"2 sided"</code> のように引用符で囲みます。</p>
    </form>

    @if (Model.Terms.Count > 0)
    {
        <p class="filter-count" aria-live="polite">
            <strong>@Model.Query</strong> の検索結果: @Model.Results.Count 件
        </p>

        @if (Model.Results.Count == 0)
        {
            <div class="empty-state">
                <p>トピックが見つかりませんでした。語句を減らすか変えてみるか、<a asp-page="/Keywords">索引</a>から探してください。</p>
            </div>
        }
        else
        {
            <ol class="search-results">
                @foreach (var hit in Model.Results)
                {
                    <li class="search-result">
                        <a class="search-result-title" href="@Url.Content("~" + hit.Topic.Url)">@hit.Topic.Title</a>
                        <p class="search-result-snippet">
                            @foreach (var (text, match) in hit.Snippet)
                            {
                                if (match) { <mark>@text</mark> } else { @text }
                            }
                        </p>
                    </li>
                }
            </ol>
        }
    }
</article>
