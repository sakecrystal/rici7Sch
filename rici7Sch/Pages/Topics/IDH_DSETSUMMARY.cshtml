@model rici7Sch.Pages.Topics.IDH_DSETSUMMARYModel
@* このファイルは tools/convert_help.py により生成されています。 *@

<p>Displays a settings summary using a list and an image of the printer.</p>
<p aria-level="2" class="T1" role="heading"><span class="Term-Soft">Settings List</span> Tab</p>
<p aria-level="3" class="T2" id="expand" role="heading"><span class="Term-Soft">Expand</span></p>
<p>Expands the settings summary list.</p>
<p aria-level="3" class="T2" id="collapse" role="heading"><span class="Term-Soft">Collapse</span></p>
<p>Collapses the expanded list.</p>
<p aria-level="3" class="T2" id="setlist" role="heading"><span class="Term-Soft">List:</span></p>
<p>Displays a list of the current print settings.</p>
<p aria-level="2" class="T1" role="heading"><span class="Term-Soft">Tray List</span> Tab</p>
<p aria-level="3" class="T2" id="image" role="heading">Machine Image</p>
<p>Displays the selected tray as an image.</p>
<p>The currently selected input tray is framed in blue, and the output 
 tray is marked with a blue triangle.</p>
<p class="Note">Note:</p>
<ul>
<li><p>When <span class="Term-Soft">Auto Tray Select</span> 
 or <span class="Term-Soft">Printer Default</span> is selected, these marks 
 are not displayed.</p></li>
</ul>
<p aria-level="3" class="T2" id="traylist" role="heading"><span class="Term-Soft">Selected Tray List:</span></p>
<p>Displays the input and output trays information.</p>
<p aria-level="3" class="T2" id="ok" role="heading"><span class="Term-Soft">OK</span></p>
<p>Closes the dialog box.</p>
